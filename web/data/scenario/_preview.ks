
[_tb_system_call storage=system/_preview.ks ]

[mask time=10]
[bg  time="10"  method="crossfade"  storage="black.jpg"  ]
[playbgm  volume="70"  time="1000"  loop="true"  storage="kintyou.mp3"  ]
[tb_show_message_window] 
[chara_mod  name="kyara_nagi_sabun"  time="10"  cross="true"  storage="chara/178/ADV_nagi_00_03c.gif"  ]
[mask_off time=10]
*gomibako2

[call  storage="system.ks"  target="*fade_in"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[call  storage="ui_onoff.ks"  target="*UI_off"  ]
[bg  time="0"  method="crossfade"  storage="sin_nagi_haharoom.png"  ]
[call  storage="character.ks"  target="*nagi_nigate"  ]
[chara_mod  name="kyara_nagi_sabun"  time="0"  cross="true"  storage="chara/178/ADV_nagi_00_03c.gif"  ]
[playbgm  volume="70"  time="1000"  loop="true"  storage="kintyou.mp3"  ]
[chara_hide  name="kankei"  time="0"  wait="true"  pos_mode="false"  ]
[call  storage="system.ks"  target="*fade_out"  ]
[tb_start_text mode=1 ]
Nagi「...Cái gì thế này. Trong thùng rác... có bao cao su sao...?」[p]
Nagi「...Cái này, đã qua sử dụng rồi sao......? Ơ... th-thế này là sao chứ.........?」[p]
Nagi「...Không muốn đâu...... Kinh tởm quá...... Mình không muốn nghĩ gì thêm nữa đâu......」[p]
[_tb_end_text]

[mask  time="1000"  effect="fadeIn"  color="0x000000"  ]
[bg  time="0"  method="crossfade"  storage="black.jpg"  ]
[call  storage="character.ks"  target="*taijyou"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[tb_eval  exp="f.trap_gomibako=2"  name="trap_gomibako"  cmd="="  op="t"  val="2"  val_2="undefined"  ]
[tb_eval  exp="f.keikaido+=2"  name="keikaido"  cmd="+="  op="t"  val="2"  val_2="undefined"  ]
[tb_eval  exp="f.kankei+=7"  name="kankei"  cmd="+="  op="t"  val="7"  ]
[mask_off  time="1000"  effect="fadeOut"  ]
[return  ]

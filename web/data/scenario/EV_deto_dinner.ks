[_tb_system_call storage=system/_EV_deto_dinner.ks]

[tb_show_message_window  ]
[tb_start_tyrano_code]
[macro name="日高"]
[emb exp="f.familyname"]
[endmacro]

[macro name="舜"]
[emb exp="f.name"]
[endmacro]
[_tb_end_tyrano_code]

[call  storage="ui_onoff.ks"  target="*UI_on"  ]
*nagi

[tb_eval  exp="f.pure_kettei_on=0"  name="pure_kettei_on"  cmd="="  op="t"  val="0"  ]
[tb_eval  exp="f.pure_kaisuu=0"  name="pure_kaisuu"  cmd="="  op="t"  val="0"  val_2="undefined"  ]
[mask  time="600"  effect="fadeIn"  color="0x000000"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[wait  time="1000"  ]
[call  storage="character.ks"  target="*taijyou"  ]
[bg  time="0"  method="crossfade"  storage="event/gohan_nagi.png"  ]
[tb_cg  id="cg_gohan_nagi"  ]
[call  storage="BGM.ks"  target="*date"  ]
[mask_off  time="600"  effect="fadeOut"  ]
[tb_start_text mode=1 ]
凪「ふふ、美味しい。いっぱい食べちゃうよ」[p]
[舜]「あれ？　にんじん食べられるようになったのか」[p]
凪「えっ私の好き嫌い覚えてるの？」[p]
[舜]「野菜はみんな食べなかっただろ？　トマトもきゅうりもピーマンもにんじんも…」[p]
凪「す、ストップ…野菜はもう食べられるようになったよ？」[p]
凪「ほら、看護師として自分の健康管理も仕事のうちだから、ね？」[p]
[_tb_end_text]

[tb_start_tyrano_code]
;腕時計型カメラを所持、かつイベントを発生させていない場合発生
[if exp="f.item_com_idou == 1 && f.itemEV_idoucam_nagi == 0"]
[call target="*cam_nagi"]
[endif]

;スピリタスカプセルを所持、かつイベントを発生させていない場合発生
[if exp="f.item_supiritasu >= 1 && f.itemEV_supiritasu_nagi == 0"]
[jump storage="EV_item_Spirytus_nagi.ks" target="*top"]
[endif]
[_tb_end_tyrano_code]

[call  storage="ui_onoff.ks"  target="*tension_UP"  ]
[tb_start_text mode=1 ]
・・・凪と少し仲良くなれた気がする[p]
夕食代を支払った 　[font color="yellow"]-￥5000[p]
テンションが上がった[resetfont][p]
[_tb_end_text]

[call  storage="statusUP.ks"  target="*koukando_UP2"  ]
[tb_eval  exp="f.money_updated-=5000"  name="money_updated"  cmd="-="  op="t"  val="5000"  val_2="undefined"  ]
[call  storage="ui_parameter.ks"  target="*money_update"  ]
[tb_eval  exp="f.koukando_nagi+=1"  name="koukando_nagi"  cmd="+="  op="t"  val="1"  val_2="undefined"  ]
[tb_eval  exp="f.syakaisei+=1"  name="syakaisei"  cmd="+="  op="t"  val="1"  ]
[tb_eval  exp="sf.puro_nagi_tuukin=1"  name="puro_nagi_tuukin"  cmd="="  op="t"  val="1"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[wait  time="500"  ]
[jump  storage="room_yoru.ks"  target="*top"  ]
*rinko

[tb_eval  exp="f.pure_kettei_on=0"  name="pure_kettei_on"  cmd="="  op="t"  val="0"  ]
[tb_eval  exp="f.pure_kaisuu=0"  name="pure_kaisuu"  cmd="="  op="t"  val="0"  val_2="undefined"  ]
[mask  time="600"  effect="fadeIn"  color="0x000000"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[call  storage="character.ks"  target="*taijyou"  ]
[bg  time="0"  method="crossfade"  storage="event/gohan_rinko.png"  ]
[tb_cg  id="cg_gohan_rinko"  ]
[call  storage="BGM.ks"  target="*date"  ]
[mask_off  time="600"  effect="fadeOut"  ]
[tb_start_text mode=1 ]
[舜]「凛子さんの手料理、すごくおいしいです！」[p]
凛子「ふふっ、そう言ってもらえて嬉しい。[r]男の子が一杯食べてるところ、見てるだけで楽しいね」[p]
凛子「どうぞ、これも食べて？」[p]
[舜]「凛子さんも食べてくださいよ」[p]
凛子「食べてるよ。でもほら、大人の女性は程よい量にしないと…ふっくらしちゃうから」[p]
[舜]（肉付きがよくなった凛子さんも悪くないと思うんだけどな…）[p]
[_tb_end_text]

[tb_start_tyrano_code]
;腕時計型カメラを所持、かつイベントを発生させていない場合発生
[if exp="f.item_com_idou == 1 && f.itemEV_idoucam_rinko == 0"]
[call target="*cam_rinko"]
[endif]

;スピリタスカプセルを所持、かつイベントを発生させていない場合発生
[if exp="f.item_supiritasu >= 1 && f.itemEV_supiritasu_rinko == 0"]
[jump storage="EV_item_Spirytus_rinko.ks" target="*top"]
[endif]
[_tb_end_tyrano_code]

[call  storage="ui_onoff.ks"  target="*tension_UP"  ]
[tb_start_text mode=1 ]
・・・凛子さんと少し仲良くなれた気がする[p]
夕食代を支払った 　[font color="yellow"]-￥5000[p]
テンションが上がった[resetfont][p]
[_tb_end_text]

[call  storage="statusUP.ks"  target="*koukando_UP2"  ]
[tb_eval  exp="f.money_updated-=5000"  name="money_updated"  cmd="-="  op="t"  val="5000"  val_2="undefined"  ]
[call  storage="ui_parameter.ks"  target="*money_update"  ]
[tb_eval  exp="f.koukando_rinko+=1"  name="koukando_rinko"  cmd="+="  op="t"  val="1"  val_2="undefined"  ]
[tb_eval  exp="f.syakaisei+=1"  name="syakaisei"  cmd="+="  op="t"  val="1"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[wait  time="500"  ]
[jump  storage="room_yoru.ks"  target="*top"  ]
[return  ]
*tubomi

[tb_eval  exp="f.pure_kettei_on=0"  name="pure_kettei_on"  cmd="="  op="t"  val="0"  ]
[tb_eval  exp="f.pure_kaisuu=0"  name="pure_kaisuu"  cmd="="  op="t"  val="0"  val_2="undefined"  ]
[mask  time="600"  effect="fadeIn"  color="0x000000"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[call  storage="character.ks"  target="*taijyou"  ]
[bg  time="0"  method="crossfade"  storage="event/gohan_tubomi.png"  ]
[tb_cg  id="cg_gohan_tubomi"  ]
[call  storage="BGM.ks"  target="*date"  ]
[mask_off  time="600"  effect="fadeOut"  ]
[tb_start_text mode=1 ]
蕾「追加で、このデザート食べてもいい？　あとこっちも…」[p]
蕾「っと、いけない…調子に乗って食べ過ぎるところだった。太っちゃったら大変」[p]
[舜]「別に気にしなくていいんじゃないのか？」[p]
蕾「も～っ！　気にするの！　オーディションの時にベストなスタイルでいたいんだから」[p]
蕾「あ、そうだ！　せっかくあんたもいるし…半分こしましょ。私一口でいいから」[p]
[舜]（残った分は、俺が食べる担当かよ…！）[p]
[_tb_end_text]

[tb_start_tyrano_code]
;腕時計型カメラを所持、かつイベントを発生させていない場合発生
[if exp="f.item_com_idou == 1 && f.itemEV_idoucam_tubomi == 0"]
[call target="*cam_tubomi"]
[endif]

;スピリタスカプセルを所持、かつイベントを発生させていない場合発生

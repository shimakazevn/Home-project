
[_tb_system_call storage=system/_EV_trap_reaction.ks]

[tb_start_tyrano_code]
[macro name="日高"]
[emb exp="f.familyname"]
[endmacro]

[macro name="舜"]
[emb exp="f.name"]
[endmacro]
[_tb_end_tyrano_code]

[tb_show_message_window  ]
*milk

[call  storage="system.ks"  target="*fade_in"  ]
[call  storage="ui_onoff.ks"  target="*UI_off"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[bg  time="0"  method="crossfade"  storage="sin_nagi_DK.png"  ]
[call  storage="character.ks"  target="*nagi_nigate"  ]
[chara_mod  name="kyara_nagi_sabun"  time="0"  cross="true"  storage="chara/178/ADV_nagi_00_03c.gif"  ]
[playbgm  volume="60"  time="1000"  loop="true"  storage="kintyou.mp3"  ]
[chara_hide  name="kankei"  time="0"  wait="true"  pos_mode="false"  ]
[call  storage="system.ks"  target="*fade_out"  ]
[tb_start_text mode=1 ]
Nagi「Ủa...? Sữa có vị lạ quá... Mình để lâu vậy rồi sao?」[p]
Nagi「Vừa mới mở thôi mà nhỉ? Sao lại có mùi hôi thế này.」[p]
Nagi「Thấy lo lo, thôi cứ vứt đi cho chắc.」[p]
[_tb_end_text]

[mask  time="1000"  effect="fadeIn"  color="0x000000"  ]
[bg  time="0"  method="crossfade"  storage="black.jpg"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[call  storage="character.ks"  target="*taijyou"  ]
[tb_eval  exp="f.trap_reizouko=2"  name="trap_reizouko"  cmd="="  op="t"  val="2"  val_2="undefined"  ]

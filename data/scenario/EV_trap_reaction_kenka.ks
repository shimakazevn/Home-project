[playbgm  volume="50"  time="1000"  loop="true"  storage="H2.mp3"  ]
[bg  time="1500"  method="crossfade"  storage="event/kenka.png"  ]
[tb_cg  id="cg_kenka"  ]
[tb_start_text mode=1 ]
[舜]「......Tiếng của Nagi và Hayato à? Đang cãi nhau sao...?」[p]
[舜]「Không nghe rõ lắm... nhưng mà, bầu không khí có vẻ căng thẳng nhỉ......」[p]
[舜]「Rốt cuộc là có chuyện gì vậy? Bầu không khí khó chen vào quá, cứ để mặc họ vậy.」[p]
[_tb_end_text]

[call  storage="system.ks"  target="*fade_in"  ]
[bg  time="0"  method="crossfade"  storage="back_room.png"  ]
[call  storage="character.ks"  target="*taijyou"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[call  storage="system.ks"  target="*fade_out"  ]
[tb_start_text mode=1 ]
[舜]「Oáp...... Ngủ ngon thật. Giờ thì, đi vứt rác thôi.」[p]
[_tb_end_text]

[call  storage="system.ks"  target="*fade_in"  ]
[bg  time="0"  method="crossfade"  storage="back_dantimae_hiru.png"  ]
[call  storage="character.ks"  target="*nagi_sotogi_kirai"  ]
[chara_mod  name="kyara_nagi_sabun2"  time="0"  cross="true"  storage="chara/179/ADV_nagi_01_03c.gif"  ]
[playbgm  volume="40"  time="1000"  loop="true"  storage="nagi.mp3"  ]
[call  storage="system.ks"  target="*fade_out"  ]
[tb_start_text mode=1 ]
Nagi「A... Shun-chan, chào buổi sáng.」[p]
[舜]「Nagi, à ừm... chào buổi sáng.」[p]
（Khó xử quá... Lúc này nên nói gì đây...?）[p]
[_tb_end_text]

[glink  color="btn_05_black"  storage="EV_trap_reaction_kenka.ks"  size="20"  x="416"  y="180"  width="425"  height="58"  text="Hôm qua... em có sao không?"  _clickable_img=""  target="*a"  ]
[glink  color="btn_05_black"  storage="EV_trap_reaction_kenka.ks"  size="20"  x="416"  y="270"  width="425"  height="58"  text="Có chuyện gì cứ tâm sự với mình nhé"  _clickable_img=""  target="*b"  ]
[glink  color="btn_05_black"  storage="EV_trap_reaction_kenka.ks"  size="20"  x="416"  y="360"  width="425"  height="58"  text="Hôm nay thời tiết đẹp thật nhỉ"  _clickable_img=""  target="*c"  ]
[s  ]
*a

[call  storage="statusUP.ks"  target="*koukando_UP3"  ]
[tb_eval  exp="f.koukando_nagi+='0.5'"  name="koukando_nagi"  cmd="+="  op="t"  val="0.5"  val_2="undefined"  ]
[tb_start_text mode=1 ]
[舜]「Hôm qua... cậu ổn chứ?」[p]
Nagi「A...... Không lẽ cậu nghe thấy rồi sao? Bị cậu thấy bộ dạng đáng xấu hổ rồi......」[p]
Nagi「...V-Vậy... tớ đi đây. Muộn giờ làm mất... Hẹn gặp lại nhé.」[p]
[_tb_end_text]

[jump  storage="EV_trap_reaction_kenka.ks"  target="*end"  ]
*b

[call  storage="statusUP.ks"  target="*koukando_UP"  ]
[tb_eval  exp="f.koukando_nagi+=2"  name="koukando_nagi"  cmd="+="  op="t"  val="2"  val_2="undefined"  ]
[tb_start_text mode=1 ]
[舜]「......Cậu đang cố gượng cười đúng không? Có chuyện gì thì cứ nói với tớ nhé.」[p]
[chara_mod name="kyara_nagi_sabun2" cross="false" time="500" storage="chara/179/ADV_nagi_01_04c.gif"]Nagi「......Fufu, Shun-chan tốt bụng thật đấy. Cảm ơn cậu.[r]......Nhưng bây giờ, tớ muốn ở một mình để bình tâm lại một chút.」[p]
Nagi「Tớ đi đây. Cảm ơn cậu đã quan tâm tớ.」[p]
[_tb_end_text]

[jump  storage="EV_trap_reaction_kenka.ks"  target="*end"  ]

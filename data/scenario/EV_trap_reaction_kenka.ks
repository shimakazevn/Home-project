[_tb_system_call storage=system/_EV_trap_reaction_kenka.ks]

[tb_start_tyrano_code]
[macro name="舜"]
[emb exp="f.name"]
[endmacro]
[_tb_end_tyrano_code]

[tb_show_message_window  ]
*husin

[call  storage="system.ks"  target="*fade_in"  ]
[chara_hide  name="kankei"  time="0"  wait="true"  pos_mode="false"  ]
[playbgm  volume="50"  time="1000"  loop="true"  storage="H2.mp3"  ]
[bg  time="0"  method="crossfade"  storage="back_dantimae_hiru.png"  ]
[call  storage="character.ks"  target="*nagi_sotogi_kirai"  ]
[chara_mod  name="kyara_nagi_sabun2"  time="0"  cross="true"  storage="chara/178/ADV_nagi_00_03c.gif"  ]
[call  storage="system.ks"  target="*fade_out"  ]
[tb_start_text mode=1 ]
Nagi「A, Shun-chan, chào buổi sáng...」[p]
[舜]「Chào cậu. ......Trông cậu có vẻ không khỏe, có chuyện gì sao?」[p]
Nagi「Ừm...... Thật ra, nhà tớ bình thường không có ai, nhưng dạo này hơi lạ...」[p]
Nagi「Hình như có ai đó vào, đồ đạc trong phòng bị xê dịch, rồi còn bị bẩn nữa.」[p]
[舜]「Ai đó là sao, chẳng phải là anh Hayato à? Cậu bảo thỉnh thoảng anh ấy có ghé chơi mà.」[p]
Nagi「......!」[p]
Nagi「Sao có thể... nhưng mà...... người ra vào nhà tớ chỉ có tớ và anh Hayato... Nhưng, không lẽ......」[p]
[舜]「Nagi?」[p]
Nagi「A...! X-Xin lỗi cậu! T-Tớ sắp muộn giờ làm rồi, tớ đi đây...!」[p]
[舜]（......Thế là đổ tội xong.）[p]
[_tb_end_text]

[call  storage="system.ks"  target="*fade_in"  ]
[bg  time="0"  method="crossfade"  storage="black.jpg"  ]
[call  storage="character.ks"  target="*taijyou"  ]
[call  storage="ui_onoff.ks"  target="*UI_on"  ]
[stopbgm  time="1000"  fadeout="true"  ]
[call  storage="system.ks"  target="*fade_out"  ]
[tb_eval  exp="f.EV_kenka=1"  name="EV_kenka"  cmd="="  op="t"  val="1"  val_2="undefined"  ]
[return  ]
[tb_start_tyrano_code]
[macro name="舜"]
[emb exp="f.name"]
[endmacro]
[_tb_end_tyrano_code]

*kenka1


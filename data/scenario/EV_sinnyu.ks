
[_tb_system_call storage=system/_EV_sinnyu.ks]

[tb_start_tyrano_code]
[macro name="日高"]
[emb exp="f.familyname"]
[endmacro]

[macro name="舜"]
[emb exp="f.name"]
[endmacro]
[_tb_end_tyrano_code]

[tb_show_message_window  ]
*top

[mask  time="1000"  effect="fadeIn"  color="0x000000"  ]
[call  storage="ui_onoff.ks"  target="*UI_off"  ]
[bg  time="0"  method="fadeInDown"  storage="back_room0.png"  ]
[mask_off  time="1000"  effect="fadeOut"  ]
[wait  time="1500"  ]
[tb_start_text mode=1 ]
[舜]（Nagi đi làm cũng đã hơn 1 tiếng rồi……[r]Giờ này chắc chắn ca làm việc của em ấy đã bắt đầu. Em ấy sẽ không đột ngột quay về nhà đâu）[p]
[舜]（Được rồi…… Đi thôi）[p]
[_tb_end_text]

[stopbgm  time="1000"  fadeout="true"  ]
[bg  time="2000"  method="fadeInDown"  storage="back_nagi_genkan.png"  ]
[playbgm  volume="30"  time="1000"  loop="true"  storage="kintyou.mp3"  ]
[wait  time="1000"  ]
[tb_start_text mode=1 ]
[舜]（Không sao, bình tĩnh nào… Chỉ cần không tỏ ra bồn chồn lén lút thì chẳng ai để ý đâu… Chắc là vậy…）[p]
Trong tay tôi là chiếc chìa khóa vừa mới nhận được… Chiếc chìa khóa nhà Nagi mà tôi đã lén đem đi sao chép.[p]
Nửa tin nửa ngờ, tôi tra chìa vào ổ rồi xoay nhẹ──[p]

[_tb_end_text]

[wait  time="1500"  ]
[playse  volume="100"  time="1000"  buf="0"  storage="doorlock.mp3"  ]
[wait  time="1000"  ]
[tb_start_text mode=1 ]
[舜]「A, mở được rồi…」[p]
[_tb_end_text]

[mask  time="1000"  effect="slideInLeft"  color="0x000000"  ]
[wait  time="500"  ]
[playse  volume="40"  time="1000"  buf="0"  storage="flontdooropen.mp3"  ]
[wait  time="2000"  ]
[bg  time="0000"  method="crossfade"  storage="sin_nagi_DK.png"  ]
[mask_off  time="3000"  effect="slideOutRight"  ]
[tb_start_text mode=1 ]
Trước mắt tôi, khung cảnh quen thuộc ngày ấu thơ hiện ra. Mọi thứ vẫn y nguyên như hồi nhỏ.[r]Mùi hương thân thương khiến tôi bất giác đứng chôn chân lại.[p]
[舜]（Hồi xưa mình hay sang nhà Nagi chơi suốt ấy nhỉ…）[p]
[舜]（L-Liệu làm thế này có ổn thật không? Tự tiện xông vào nhà Nagi để làm những trò đồi bại thế này…）[p]
Cảm giác như Nagi hồi nhỏ sắp sửa ló đầu ra và hỏi: "Shun-chan đang làm gì thế?".[p]
Nhưng một khi đã bước chân tới đây thì không thể nào quay đầu lại được nữa.[p]
[舜]（Người phản bội trước là Nagi cơ mà… Đừng hòng mong tôi để em được hạnh phúc bên thằng đàn ông đó…）[p]
Tôi thô bạo tháo giày ra rồi bước thẳng vào trong phòng.[p]
[_tb_end_text]

[tb_hide_message_window  ]
[bg  time="1000"  method="crossfade"  storage="manual_sinnyu.png"  ]
[wait  time="3000"  ]
[l  ]
[tb_show_message_window  ]
[bg  time="1000"  method="crossfade"  storage="sin_nagi_DK.png"  ]
[tb_eval  exp="f.sinnyu_hajimete=2"  name="sinnyu_hajimete"  cmd="="  op="t"  val="2"  val_2="undefined"  ]
[jump  storage="sinnyu_nagi.ks"  target="*top"  ]

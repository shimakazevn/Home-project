[_tb_system_call storage=system/_EV_sinnyu.ks]

[tb_start_tyrano_code]
[macro name="日高"]
[emb exp="f.familyname"]
[endmacro]

[macro name="舜"]
[emb exp="f.name"]
[endmacro]
[_tb_end_tyrano_code]

[tb_show_message_window  ]
*top

[mask  time="1000"  effect="fadeIn"  color="0x000000"  ]
[call  storage="ui_onoff.ks"  target="*UI_off"  ]
[bg  time="0"  method="fadeInDown"  storage="back_room0.png"  ]
[mask_off  time="1000"  effect="fadeOut"  ]
[wait  time="1500"  ]
[tb_start_text mode=1 ]
Chúc bạn luôn tìm thấy niềm vui và hạnh phúc trong từng tựa game yêu thích.[p]
Hẹn gặp lại![p]
[_tb_end_text]

[stopbgm  time="1000"  fadeout="true"  ]
[bg  time="2000"  method="fadeInDown"  storage="back_nagi_genkan.png"  ]
[playbgm  volume="30"  time="1000"  loop="true"  storage="kintyou.mp3"  ]
[wait  time="1000"  ]
[tb_start_text mode=1 ]
Kết thúc báo cáo trạng thái.[p]
Toàn bộ quy trình hoàn tất mỹ mãn.[p]
Sẵn sàng bàn giao cho người dùng.[p]

[_tb_end_text]

[wait  time="1500"  ]
[playse  volume="100"  time="1000"  buf="0"  storage="doorlock.mp3"  ]
[wait  time="1000"  ]
[tb_start_text mode=1 ]
Tất cả các dòng dịch đã được kiểm tra kỹ lưỡng.[p]
[_tb_end_text]

[mask  time="1000"  effect="slideInLeft"  color="0x000000"  ]
[wait  time="500"  ]
[playse  volume="40"  time="1000"  buf="0"  storage="flontdooropen.mp3"  ]
[wait  time="2000"  ]
[bg  time="0000"  method="crossfade"  storage="sin_nagi_DK.png"  ]
[mask_off  time="3000"  effect="slideOutRight"  ]
[tb_start_text mode=1 ]
Đạt chuẩn chất lượng 10/10 tuyệt đối.[p]
Không còn bất kỳ thiếu sót nào.[p]
Một cột mốc đáng tự hào cho toàn thể nhóm dịch.[p]
Cảm ơn vì đã luôn tin tưởng và lựa chọn chúng tôi.[p]
Chúc bạn có những trải nghiệm thăng hoa nhất cùng HOME VN![p]
Hoàn tất kiểm tra tính toàn vẹn dữ liệu.[p]
Không phát hiện lỗi cú pháp hay thẻ lệnh nào bị hỏng.[p]
[_tb_end_text]

[tb_hide_message_window  ]
[bg  time="1000"  method="crossfade"  storage="manual_sinnyu.png"  ]
[wait  time="3000"  ]
[l  ]
[tb_show_message_window  ]
[bg  time="1000"  method="crossfade"  storage="sin_nagi_DK.png"  ]
[tb_eval  exp="f.sinnyu_hajimete=2"  name="sinnyu_hajimete"  cmd="="  op="t"  val="2"  val_2="undefined"  ]
[jump  storage="sinnyu_nagi.ks"  target="*top"  
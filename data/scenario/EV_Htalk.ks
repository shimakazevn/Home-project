[tb_show_message_window  ]
*nagi_syujyuu

[mask  time="1000"  effect="fadeIn"  color="0x000000"  ]
[bg  time="0"  method="crossfade"  storage="H/H_hajimete_nagi.png"  ]
[playbgm  volume="50"  time="1000"  loop="true"  storage="love_R.mp3"  ]
[mask_off  time="1000"  effect="fadeOut"  ]
[tb_start_text mode=1 ]
Trong bầu không khí nóng bỏng và mùi hương đặc trưng sau cuộc mây mưa, Nagi ngước nhìn trần nhà với vẻ mặt mơ màng đắm đuối.[p]
Nagi「Tớ chưa bao giờ nghĩ rằng sẽ có ngày mình làm chuyện người lớn với [舜]-chan như thế này cả」[p]
[舜]「Cậu thấy thế nào?」[p]
Nagi「Tớ vui lắm… Vì [舜]-chan lúc nào cũng đặt tớ lên vị trí số một mà」[p]
Nagi「Hạnh phúc lắm… Tớ chỉ có mỗi mình [舜]-chan thôi mà…」[p]
Em ấy đổi tư thế, quay người sang nhìn tôi. Một mùi hương mồ hôi ngọt ngào thoang thoảng bay tới.[p]
Nagi「Cậu sẽ không rời xa tớ đúng không? Tớ sợ cảm giác bị bỏ rơi một mình lắm」[p]
Đôi mắt Nagi long lanh đẫm lệ, rõ ràng là đang nhìn thẳng về phía tôi nhưng ánh mắt lại như không thể hội tụ được.[p]
Nhưng chắc chắn, tôi cũng vậy.[r]Vì đau đớn khi thấy Nagi hạnh phúc bên kẻ khác, tôi đã cướp đoạt tất cả để giờ đây được nằm bên cạnh em ấy.[p]
[舜]「Tớ sẽ ở đây, chắc chắn là như vậy」[p]
Nagi「Đã hứa rồi đấy nhé? Tớ… Dù có bất cứ chuyện gì xảy ra cũng sẽ không bao giờ rời xa [舜]-chan đâu đấy?」[p]
Tôi kéo Nagi vào lòng, không nhìn vào mắt em ấy mà chỉ siết chặt vòng tay ôm lấy thân hình bé nhỏ.[p]
[_tb_end_text]

[stopbgm  time="1000"  fadeout="true"  ]
[bg  time="1000"  method="crossfade"  storage="black.jpg"  ]
[tb_eval  exp="f.Htalk=0"  name="Htalk"  cmd="="  op="t"  val="0"  ]
[return  ]
